{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smartlearn-payments",
  "main": "src/index.js",
  "compatibility_date": "2026-10-09",
  "vars": {
    "ALLOWED_ORIGIN": "https://nelsonudoffa.github.io",
    "PAYSTACK_PLAN_CODE": "PLN_fbxdzjgbyrud001",
    "PAYSTACK_CALLBACK_URL": "https://nelsonudoffa.github.io/Smartlearn/#payment-return"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "smartlearn-payments",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"
    }
  ],
  "secrets": {
    "required": [
      "PAYSTACK_SECRET_KEY"
    ]
  }
}